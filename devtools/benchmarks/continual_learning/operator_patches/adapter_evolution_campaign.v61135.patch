+def test_official_parser_copy_matches_claude_adapter():
+    """Our answer locator must stay byte-identical to the Claude Code adapter's."""
+    import re
+    def func(src, name):
+        i = src.find(f"\ndef {name}(") + 1
+        m = re.search(r"\n(?=(def |class |@|[A-Za-z_]))", src[i + 1:])
+        end = i + 1 + m.start() if m else len(src)   # last construct in file: run to EOF
+        return src[i:end].rstrip()
+    claude = open("src/systems/claude/system.py").read()
+    ours = open("src/systems/ouroboros/action_parse.py").read()
+    for name in ("_json_candidates", "_parse_action_text"):
+        assert func(claude, name) == func(ours, name), f"{name} drifted from the claude adapter"
+
