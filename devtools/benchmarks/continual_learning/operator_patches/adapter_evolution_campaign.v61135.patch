+def _restart_pending_refusal(exc: Exception) -> bool:
+    """True when the engine refused a submit because a restart is armed.
+
+    The restart-admission fence (present in the local 6.113.5 engine branch, supervisor/task_admission.py; not in public releases through 6.114.0) answers
+    503 with a retryable receipt and writes no durable row. Match on the HTTP status plus
+    the typed hint so an ordinary 503 (server re-exec) keeps the fast-retry path.
+    """
+    import urllib.error
+    if not isinstance(exc, urllib.error.HTTPError) or exc.code != 503:
+        return False
+    try:
+        body = exc.read().decode("utf-8", "replace")
+    except Exception:  # noqa: BLE001 — body already consumed or unreadable
+        return True     # a 503 we cannot inspect: prefer waiting over burning retries
+    low = body.lower()
+    return ("restart" in low) or ('"retryable": true' in low.replace(" ", "")) or ("retryable" in low)
