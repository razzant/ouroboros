+    marker = tmp_path / "state" / "pending_restart_verify.claimed.7.json"
+    now, posts, probes, sleeps = [0.0], [], [], []
+    refusals_armed = [never_clears]
+    healthy = {
+        "supervisor_ready": True,
+        "workers_alive": 1,
+        "evolution_enabled": False,
+        "pending_count": 0,
+        "running_count": 0,
+        "evolution_state": {"queued_task_id": "", "running_task_id": ""},
+        "active_direct_turns": [],
+        "active_chat_activities": [],
+        "sha": "a" * 40,
+        "uptime": 1000,
+    }
+
+    def sleep(seconds):
+        assert 0 < seconds <= 8
+        assert len(sleeps) < 500, "restart wait renewed or stopped advancing"
+        sleeps.append(seconds)
+        now[0] += seconds
+        if posts and not refusals_armed[0] and now[0] >= posts[0] + 40:
+            marker.unlink(missing_ok=True)
+
+    def api(base, method, path, body=None, timeout=60):
+        if method == "GET":
+            assert path == "/api/state" and timeout > 0
+            probes.append(now[0])
