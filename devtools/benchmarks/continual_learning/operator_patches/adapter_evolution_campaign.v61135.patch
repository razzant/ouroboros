+def _fake_observability(tmp_path, tid, outputs):
+    """outputs: list of (name, content, age_sec) — writes engine-shaped call/blob pairs."""
+    import gzip, json, os, time
+    calls = tmp_path / "observability" / "calls" / tid; calls.mkdir(parents=True)
+    blobs = tmp_path / "observability" / "blobs"; blobs.mkdir(parents=True, exist_ok=True)
+    for k, (name, content, age) in enumerate(outputs):
+        sha = f"{k:064x}"
+        with gzip.open(blobs / f"{sha}.json.gz", "wt") as fh:
+            json.dump({"message": {"content": content}, "usage": {}}, fh)
+        p = calls / name; p.write_text(json.dumps({"full_payload_ref": {"sha256": sha}}))
+        ts = time.time() - age; os.utime(p, (ts, ts))
+
