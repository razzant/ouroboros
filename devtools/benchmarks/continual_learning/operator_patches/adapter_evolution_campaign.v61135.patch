+def _boundary_api_shape_issues(state: dict) -> list[str]:
+    """Check the gateway field contract separately from observed activity."""
+    issues = []
+    fields = {
+        "supervisor_ready": bool,
+        "workers_alive": int,
+        "evolution_enabled": bool,
+        "pending_count": int,
+        "running_count": int,
+        "evolution_state": dict,
+        "active_direct_turns": list,
+        "active_chat_activities": list,
+    }
+    for key, expected in fields.items():
+        if key not in state:
+            issues.append(f"missing API field: {key}")
+        elif type(state[key]) is not expected:
+            issues.append(f"invalid API field: {key}")
+    evolution = state.get("evolution_state")
+    if isinstance(evolution, dict):
+        for key in ("queued_task_id", "running_task_id"):
+            if key not in evolution:
+                issues.append(f"missing API field: evolution_state.{key}")
+            elif evolution[key] is not None and not isinstance(evolution[key], str):
+                issues.append(f"invalid API field: evolution_state.{key}")
+    return issues
+
+
+def _transaction_restart_unresolved(tx: dict) -> bool:
+    """Match the engine's committed-transaction restart obligation."""
+    return bool(str(tx.get("commit_sha") or "").strip()) and (
+        bool(tx.get("restart_required")) or not bool(tx.get("restart_verified"))
+    )
+
+
+def _campaign_transactions(campaign: dict, blockers: list[str]) -> dict:
+    """Index durable transactions by campaign, transaction AND task identity."""
+    transactions = {}
+    rows = []
+    for field in ("history", "transaction_history"):
+        history = campaign.get(field, [])
+        if not isinstance(history, list):
+            blockers.append(f"invalid campaign {field}")
+            continue
+        for index, row in enumerate(history):
+            location = f"{field}[{index}]"
+            if field == "history" and isinstance(row, dict):
+                # The lifecycle explicitly preserves legacy history-only rows.
+                if "transaction" not in row:
+                    continue
+                tx = row["transaction"]
+                if not isinstance(tx, dict) or row.get("task_id") != tx.get("task_id"):
+                    blockers.append(f"invalid campaign {location} transaction")
+                    continue
+                row = tx
+            rows.append((location, row))
+    active = campaign.get("active_transaction", {})
+    if not isinstance(active, dict):
+        raise ValueError("invalid active transaction")
+    if active:
+        rows.append(("active_transaction", active))
+    for location, tx in rows:
+        if not isinstance(tx, dict):
+            blockers.append(f"invalid campaign {location}")
+            continue
+        key = tuple(tx.get(k) for k in ("campaign_id", "transaction_id", "task_id"))
+        if not all(isinstance(k, str) and k.strip() for k in key):
+            blockers.append(f"missing transaction identity in {location}")
+            continue
+        transactions[key] = tx
+    return transactions
