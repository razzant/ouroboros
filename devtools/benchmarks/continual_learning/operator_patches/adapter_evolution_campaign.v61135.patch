+class _BoundaryScript:
+    """Advance host files and API telemetry together on each fake polling sleep."""
+
+    def __init__(self, root, initial, frames):
+        self.root = root / "state"
+        self.root.mkdir()
+        self.frames = frames
+        self.index = -1
+        self.now = 0.0
+        self.sleeps = []
+        self.reads = []
+        self.publications = 0
+        self.api_cost = 0.0
+        self.apply(initial)
+
+    def apply(self, frame):
+        self.frame = copy.deepcopy(frame)
+        (self.root / "state.json").write_text(
+            json.dumps({"evolution_mode_enabled": frame["enabled"]})
+        )
+        campaign_path = self.root / "evolution_campaign.json"
+        campaign = frame["campaign"]
+        if campaign is None:
+            campaign_path.unlink(missing_ok=True)
+        else:
+            campaign_path.write_text(
+                campaign if isinstance(campaign, str) else json.dumps(campaign)
+            )
+        request = self.root / "post_task_evolution_request.json"
+        if frame["request"]:
+            request.write_text("{}")
+        else:
+            request.unlink(missing_ok=True)
+        for marker in self.root.glob("pending_restart_verify*.json"):
+            marker.unlink()
+        for name in frame["markers"]:
+            (self.root / name).write_text("{}")
+
+    def advance(self):
+        self.index = min(self.index + 1, len(self.frames) - 1)
+        self.apply(self.frames[self.index])
+
+    def monotonic(self):
+        return self.now
+
+    def sleep(self, duration):
+        assert 0 < duration <= min(8.0, self.deadline() - self.now)
+        assert len(self.sleeps) < 1000, "readiness polling must remain bounded"
+        self.sleeps.append((self.now, duration))
+        self.now += duration
+        self.advance()
+
+    def api(self, base, method, path, body=None, timeout=30.0):
+        assert method == "GET" and path == "/api/state"
+        assert 0 < timeout <= min(8.0, self.deadline() - self.now)
+        assert len(self.reads) < 1000, "readiness probes must remain bounded"
+        self.reads.append((self.now, timeout))
+        self.now += min(self.api_cost, timeout)
+        if self.frame["api_error"]:
+            raise OSError("scripted supervisor restart")
+        return copy.deepcopy(self.frame["api"])
+
+    def publish(self, root, objective):
+        self.publications += 1
+        # Consumption can complete immediately; the baseline must already be captured.
+        self.advance()
+        return True
+
