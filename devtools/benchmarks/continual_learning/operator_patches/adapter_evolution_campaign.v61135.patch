+def test_task_assistant_text_is_oldest_first_and_parser_prefers_latest_valid(tmp_path):
+    """2026-09-02: a complete schema-valid answer written as plain text (no marker) ended as
+    final_answer="" / result={"delivery_control":"keep"}. Assembling the task's assistant text
+    like the official adapters and applying their parser recovers it: the trailing control
+    envelope fails the schema and the parser walks back to the latest valid JSON."""
+    from pydantic import BaseModel
+    from src.systems.ouroboros import _live_bridge as lb
+    from src.systems.ouroboros.action_parse import _parse_action_text
+
+    class Schema(BaseModel):
+        predictions: list[dict]
+
+    good = '{"predictions": [{"locality": "SF", "furniture_name": "Chair", "year": 2032, "items_sold": 3}]}'
+    _fake_observability(tmp_path, "abc123", [
+        ("llm_a_response.json", "thinking about the data", 30),
+        ("llm_b_response.json", "analysis...\n" + good, 20),
+        ("llm_c_response.json", '{"delivery_control":"keep"}', 1),
+    ])
+
+    class _Eng: data_root = tmp_path
+    ctl = lb.LiveController.__new__(lb.LiveController); ctl.engine = _Eng()
+    text = ctl._task_assistant_text("abc123")
+    assert text.index("thinking") < text.index('"predictions"') < text.index("delivery_control")
+    combined = text + "\n" + '{"delivery_control":"keep"}'   # result text appended like the ladder does
+    out = _parse_action_text(combined, Schema)
+    assert out.predictions[0]["items_sold"] == 3
+
+    src = open("src/systems/ouroboros/_live_bridge.py").read()
+    body = src.split("def _final_answer_action", 1)[1]
+    # the official walk (most-recent candidate first, shared validator) runs before coercion/repair
+    assert "reversed(_json_candidates(combined))" in body
+    assert "validate_with_coercion(candidate, schema)" in body
+    assert body.index("reversed(_json_candidates(combined))") < body.index("self._coerce_final(raw, schema, tid, why)")
