+    ctl._restart_wait_started = 0.0
+    ctl._restart_wait_deadline = 1800.0
+    ctl.engine.evolution = docker_gate
+    if docker_gate:
+        engine = docker.DockerOuroborosEngine.__new__(docker.DockerOuroborosEngine)
+        engine._started = True
+        engine._data_root = tmp_path
