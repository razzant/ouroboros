+                # The restarted gateway has older telemetry in the renewed window.
+                return {
+                    key: value for key, value in healthy.items()
+                    if key != "active_direct_turns"
+                }
+            return healthy
+        assert (method, path) == ("POST", "/api/tasks")
+        if not posts and first_post_crosses_deadline:
+            # The gate was quiet, then the POST overlapped the old deadline.
+            now[0] = 1803.0
+        posts.append(now[0])
+        if len(posts) == 1 or refusals_armed[0]:
+            marker.write_text("{}")
