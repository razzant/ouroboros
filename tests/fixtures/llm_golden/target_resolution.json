{
  "cases": [
    {
      "id": "target.openrouter_default",
      "route": "un-prefixed model -> OpenRouter target with the Ouroboros header set",
      "spec": {
        "env": {
          "OPENROUTER_API_KEY": "or-fixture-key"
        },
        "call": {
          "kind": "resolve_target",
          "model": "x-ai/grok-4.5"
        }
      },
      "expected": {
        "returned": {
          "value": {
            "provider": "openrouter",
            "resolved_model": "x-ai/grok-4.5",
            "usage_model": "x-ai/grok-4.5",
            "api_key": "or-fixture-key",
            "base_url": "https://openrouter.ai/api/v1",
            "default_headers": {
              "HTTP-Referer": "https://ouroboros-agent.ai/",
              "X-OpenRouter-Title": "Ouroboros"
            },
            "supports_openrouter_extensions": true,
            "supports_generation_cost": true
          },
          "value_sha256": "90d81cc3c49473ad3fda24e76d38dec58c10df1e6f0ba5ad306c75c742537394"
        },
        "sends": [],
        "unused_script_steps": 0
      }
    },
