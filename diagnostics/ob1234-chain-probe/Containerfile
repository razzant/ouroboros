# OB#1234 chain probe userspace: stock Silverblue 43 + the minimum the published
# launchers need to start headless. Every addition is recorded; nothing else changes.
# multi-user.target: gdm/graphical units cannot work without a seat; D-Bus stays.
FROM quay.io/fedora/fedora-silverblue@sha256:fa844d941753eab745fced0e059519e969551339b2138e05da5154a55d2389f2
RUN set -eux; \
    rpm -qa --qf '%{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}\n' | sort > /usr/share/ob1234-rpm-before.txt; \
    need=''; \
    command -v git >/dev/null || need="$need /usr/bin/git"; \
    command -v dbus-run-session >/dev/null || need="$need /usr/bin/dbus-run-session"; \
    if [ -n "$need" ]; then \
        if command -v dnf >/dev/null; then dnf -y install --setopt=install_weak_deps=False $need && dnf clean all; \
        else rpm-ostree install -y $need; fi; \
    fi; \
    rpm -qa --qf '%{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}\n' | sort > /usr/share/ob1234-rpm-after.txt; \
    comm -13 /usr/share/ob1234-rpm-before.txt /usr/share/ob1234-rpm-after.txt > /usr/share/ob1234-rpm-added.txt; \
    systemctl set-default multi-user.target; \
    useradd -m -u 1500 qa
